# Google Gemini API Key (required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Output settings
MAX_RESUME_PAGES=2
PDF_PAPER_SIZE=A4
PDF_MARGIN_TOP=15mm
PDF_MARGIN_BOTTOM=15mm
PDF_MARGIN_LEFT=15mm
PDF_MARGIN_RIGHT=15mm

# Scoring thresholds
QUICK_SCORE_THRESHOLD=0.4
MAX_DEEP_SCORE_CANDIDATES=30

# MongoDB Atlas Configuration (Cloud NoSQL job storage)
# e.g.: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=hireready
MONGODB_COLLECTION=job_listings

# Logging
LOG_LEVEL=INFO
